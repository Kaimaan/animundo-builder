{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://animundo-builder/contracts/admin-action.schema.json",
  "title": "What the admin panel asks the worker to do about a border area",
  "type": "object",
  "additionalProperties": false,
  "required": ["admin_uid", "action", "tile", "at"],
  "properties": {
    "admin_uid": {"type": "string", "minLength": 1},
    "action": {
      "enum": [
        "approve_request",
        "turn_down_request",
        "ship_item",
        "not_accepted_item",
        "reopen_request"
      ]
    },
    "tile": {"type": "string", "pattern": "^[ns]_[0-9]{3}_[0-9]{3}$"},
    "item": {"type": "string", "minLength": 1},
    "reason": {
      "enum": ["too_costly", "odd_request", "not_now", "quality", "other"]
    },
    "note": {"type": "string", "maxLength": 300},
    "at": {"type": "string", "minLength": 1},
    "done_at": {"type": "string"},
    "error": {"type": "string"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"action": {"enum": ["ship_item", "not_accepted_item"]}}
      },
      "then": {"required": ["item"]}
    },
    {
      "if": {
        "properties": {"action": {"enum": ["turn_down_request", "not_accepted_item"]}}
      },
      "then": {"required": ["reason"]}
    }
  ]
}
