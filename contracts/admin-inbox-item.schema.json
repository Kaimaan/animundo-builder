{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://animundo-builder/contracts/admin-inbox-item.schema.json",
  "title": "One item in the admin panel's inbox, written by the worker",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "draft_id", "urgent", "at"],
  "properties": {
    "kind": {"enum": ["problem", "ask_person", "not_right", "failed", "spending", "submitted"]},
    "draft_id": {"type": "string", "minLength": 1},
    "job_id": {"type": "string"},
    "reason": {"type": "string"},
    "note": {"type": "string", "maxLength": 300},
    "urgent": {"type": "boolean"},
    "handled": {"type": "boolean"},
    "handled_at": {"type": "string"},
    "at": {"type": "string"}
  }
}
