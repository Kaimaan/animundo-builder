{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://animundo-builder/contracts/area.schema.json",
  "title": "One border area: the plan, the route, the build status children see as coming soon",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "tile",
    "route",
    "name",
    "status",
    "approval",
    "plan",
    "estimate_usd",
    "cost_usd",
    "coming",
    "items",
    "version",
    "tiles",
    "updated_at"
  ],
  "properties": {
    "format": {"const": 1},
    "tile": {"type": "string", "pattern": "^[ns]_[0-9]{3}_[0-9]{3}$"},
    "route": {"enum": ["code", "admin"]},
    "name": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "fi"],
      "properties": {
        "en": {"type": "string", "minLength": 1},
        "fi": {"type": "string", "minLength": 1}
      }
    },
    "status": {
      "enum": [
        "waiting",
        "being_built",
        "being_checked",
        "ready",
        "turned_down",
        "failed"
      ]
    },
    "approval": {"enum": ["pending", "approved", "turned_down"]},
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expand": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "home": {"type": "string", "minLength": 1},
            "animal": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
            "food": {
              "type": "array",
              "items": {"type": "string", "minLength": 1}
            },
            "find": {"type": "string", "minLength": 1}
          }
        },
        "improve": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        }
      }
    },
    "estimate_usd": {"type": "number", "minimum": 0},
    "cost_usd": {"type": "number", "minimum": 0},
    "coming": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "what", "status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["home", "animal", "plant", "food"]},
          "what": {"type": "string", "minLength": 1},
          "status": {
            "enum": ["building", "checking", "shipped", "not_accepted", "failed"]
          }
        }
      }
    },
    "version": {"type": "integer", "minimum": 1},
    "tiles": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[ns]_[0-9]{3}_[0-9]{3}$"}
    },
    "reason": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1}
  }
}
