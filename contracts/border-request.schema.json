{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://animundo-builder/contracts/border-request.schema.json",
  "title": "One border request per tile: how many players came near, never who",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "tile",
    "reason",
    "habitat",
    "notes",
    "notes_by_day",
    "species_played",
    "priority",
    "created_at",
    "last_note_at"
  ],
  "properties": {
    "format": {"const": 1},
    "tile": {"type": "string", "pattern": "^[ns]_[0-9]{3}_[0-9]{3}$"},
    "reason": {"enum": ["no_home", "no_land", "no_animal", "excluded", "unmade"]},
    "habitat": {
      "enum": [
        "boreal_forest",
        "boreal_lake",
        "desert",
        "forest",
        "grassland",
        "ice",
        "lake",
        "mangrove",
        "mountain",
        "rainforest",
        "reef",
        "river",
        "savanna",
        "sea",
        "tundra",
        "wetland",
        "dry_forest",
        "mediterranean",
        "open_ocean"
      ]
    },
    "notes": {"type": "integer", "minimum": 1},
    "notes_by_day": {
      "type": "object",
      "propertyNames": {"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
      "additionalProperties": {"type": "integer", "minimum": 1}
    },
    "species_played": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {"type": "integer", "minimum": 1}
    },
    "priority": {"type": "number", "minimum": 0},
    "created_at": {"type": "string", "minLength": 1},
    "last_note_at": {"type": "string", "minLength": 1}
  }
}
