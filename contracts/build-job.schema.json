{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://animundo-builder/contracts/build-job.schema.json",
  "title": "One build job: approved work the builder builds within its budget",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "kind",
    "items",
    "budget_usd",
    "visibility",
    "created_by",
    "status",
    "cost_usd",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "format": {"const": 1},
    "tile": {"type": "string", "pattern": "^z10_[0-9]{4}_[0-9]{4}$"},
    "kind": {"enum": ["code", "build", "enrich", "remake", "place", "range"]},
    "items": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "tiles": {
      "type": "array",
      "description": "For enrich: every tile that lists the thing in wanted, most played first, any number since overlays (0059). For remake: the tiles the pass changed. For range: the listed tiles to judge.",
      "items": {"type": "string", "pattern": "^z10_[0-9]{4}_[0-9]{4}$"}
    },
    "spread": {
      "type": "object",
      "description": "For spread and range: the one thing reaching tiles.",
      "additionalProperties": false,
      "required": ["kind", "what"],
      "properties": {
        "kind": {"enum": ["animal", "plant"]},
        "what": {"type": "string", "minLength": 1}
      }
    },
    "priority": {
      "type": "number",
      "description": "For range: lowest first; 0 when missing."
    },
    "world": {
      "type": "string",
      "minLength": 1,
      "description": "For remake: the world commit the pass made its tiles with."
    },
    "enrich": {
      "type": "object",
      "description": "For enrich: the one wanted thing to make.",
      "additionalProperties": false,
      "required": ["kind", "what"],
      "properties": {
        "kind": {"enum": ["animal", "plant"]},
        "what": {"type": "string", "minLength": 1},
        "from": {"type": "string", "minLength": 1}
      }
    },
    "versions": {
      "type": "object",
      "description": "For remake, when published: each remade tile's new version. Enrich and spread publish overlays instead since 0059.",
      "propertyNames": {"pattern": "^z10_[0-9]{4}_[0-9]{4}$"},
      "additionalProperties": {"type": "integer", "minimum": 1}
    },
    "pack": {
      "type": "string",
      "minLength": 1,
      "description": "For enrich and spread, when published with passing tiles: the overlay pack's Storage prefix."
    },
    "overlay": {
      "type": "array",
      "description": "For enrich, spread and range, when published: the tiles in the overlay pack.",
      "items": {"type": "string", "pattern": "^z10_[0-9]{4}_[0-9]{4}$"}
    },
    "skipped": {
      "type": "object",
      "description": "For spread and range, when published: judged tiles that stay out, {tile: short code}.",
      "propertyNames": {"pattern": "^z10_[0-9]{4}_[0-9]{4}$"},
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "gaps": {
      "type": "object",
      "description": "For enrich, spread and range, when published: per-tile food gaps {tile: {diet, hunts}}.",
      "propertyNames": {"pattern": "^z10_[0-9]{4}_[0-9]{4}$"},
      "additionalProperties": {
        "type": "object",
        "properties": {
          "diet": {"type": "array", "items": {"type": "string"}},
          "hunts": {"type": "array", "items": {"type": "string"}}
        },
        "required": ["diet", "hunts"]
      }
    },
    "budget_usd": {"type": "number", "minimum": 0},
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "When published: the published copy's own tile version."
    },
    "visibility": {"enum": ["public", "private"]},
    "private_to": {"type": "string", "minLength": 1},
    "created_by": {"enum": ["policy", "admin", "enrich", "builder"]},
    "status": {
      "enum": ["queued", "building", "checking", "waiting_yes", "published", "failed"]
    },
    "seated": {
      "type": "object",
      "description": "For range, while judging: the seating union so far.",
      "additionalProperties": false,
      "required": ["playable", "prey", "predators"],
      "properties": {
        "playable": {"type": "boolean"},
        "prey": {"type": "boolean"},
        "predators": {"type": "boolean"}
      }
    },
    "survey_left_out": {
      "type": "array",
      "description": "What the tiles' surveys found that has a file but still isn't on the tiles: the labels or the select dropped it. Each names its first part and a short why. A report, never a request (#278.3).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["what", "part", "why"],
        "properties": {
          "what": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "part": {"type": "string", "minLength": 1},
          "why": {"type": "string", "minLength": 1}
        }
      }
    },
    "place": {
      "type": "string",
      "minLength": 1,
      "description": "For place: the place in words."
    },
    "want": {
      "type": "array",
      "description": "For place: wanted species ids first.",
      "items": {"type": "string", "minLength": 1}
    },
    "research": {
      "type": "object",
      "description": "For place at its stop: tiles, biome, species with sources, missing."
    },
    "price": {
      "type": "number",
      "minimum": 0,
      "description": "For place at its stop: the build's estimate in USD."
    },
    "spent_usd": {
      "type": "number",
      "minimum": 0,
      "description": "For place at its stop: the research's spend."
    },
    "place_yes": {
      "type": "object",
      "description": "Kai's yes: {cap, at}. Consumed once."
    },
    "place_no": {
      "type": "object",
      "description": "Kai's no: {at}. Fails the job turned_down."
    },
    "price_usd": {
      "type": "number",
      "minimum": 0,
      "description": "For remake at its stop: the survey's or build's estimate in USD."
    },
    "remake_yes": {
      "type": "object",
      "description": "Kai's yes to a priced remake: {cap, at}. Consumed once."
    },
    "remake_no": {
      "type": "object",
      "description": "Kai's no to a priced remake: {at}. Fails the job turned_down."
    },
    "needed_land": {
      "type": "string",
      "minLength": 1,
      "description": "For place with no biome: the land it needs."
    },
    "cap_usd": {
      "type": "number",
      "minimum": 0,
      "description": "For place past its yes: the approved build cap."
    },
    "phase": {
      "type": "string",
      "minLength": 1,
      "description": "For place past its yes: where the build stands."
    },
    "progress": {
      "description": "Per-item entries, or {done, of} for a range job.",
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status", "cost_usd"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "status": {"enum": ["building", "checking", "failed"]},
              "report": {"type": "string", "minLength": 1},
              "cost_usd": {"type": "number", "minimum": 0}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["done", "of"],
          "properties": {
            "done": {"type": "integer", "minimum": 0},
            "of": {"type": "integer", "minimum": 0}
          }
        }
      ]
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pack"],
      "properties": {
        "pack": {"type": "string", "minLength": 1}
      }
    },
    "review": {
      "type": "object",
      "propertyNames": {"pattern": "^.+$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["result", "at"],
        "properties": {
          "result": {"enum": ["shipped", "not_accepted"]},
          "reason": {"enum": ["quality", "other"]},
          "at": {"type": "string", "minLength": 1}
        }
      }
    },
    "cost_usd": {"type": "number", "minimum": 0},
    "error": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"visibility": {"const": "private"}}},
      "then": {"required": ["private_to"]}
    },
    {
      "if": {"properties": {"kind": {"const": "remake"}}},
      "then": {"required": ["tiles"]},
      "else": {
        "if": {"properties": {"kind": {"const": "place"}}},
        "then": {"required": ["place"]},
        "else": {"required": ["tile"]}
      }
    }
  ]
}
