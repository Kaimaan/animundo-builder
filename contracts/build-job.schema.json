{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://animundo-builder/contracts/build-job.schema.json",
  "title": "One build job: approved work the builder builds within its budget",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "kind",
    "items",
    "budget_usd",
    "visibility",
    "created_by",
    "status",
    "cost_usd",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "format": {"const": 1},
    "tile": {"type": "string", "pattern": "^z10_[0-9]{4}_[0-9]{4}$"},
    "kind": {"enum": ["code", "build", "enrich", "remake"]},
    "items": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "tiles": {
      "type": "array",
      "description": "For enrich: every tile that lists the thing in wanted, most played first, any number since overlays (0059). For remake: the tiles the pass changed.",
      "items": {"type": "string", "pattern": "^z10_[0-9]{4}_[0-9]{4}$"}
    },
    "world": {
      "type": "string",
      "minLength": 1,
      "description": "For remake: the world commit the pass made its tiles with."
    },
    "enrich": {
      "type": "object",
      "description": "For enrich: the one wanted thing to make.",
      "additionalProperties": false,
      "required": ["kind", "what"],
      "properties": {
        "kind": {"enum": ["animal", "plant"]},
        "what": {"type": "string", "minLength": 1},
        "from": {"type": "string", "minLength": 1}
      }
    },
    "versions": {
      "type": "object",
      "description": "For remake, when published: each remade tile's new version. Enrich and spread publish overlays instead since 0059.",
      "propertyNames": {"pattern": "^z10_[0-9]{4}_[0-9]{4}$"},
      "additionalProperties": {"type": "integer", "minimum": 1}
    },
    "pack": {
      "type": "string",
      "minLength": 1,
      "description": "For enrich and spread, when published with passing tiles: the overlay pack's Storage prefix."
    },
    "overlay": {
      "type": "array",
      "description": "For enrich and spread, when published: the tiles in the overlay pack.",
      "items": {"type": "string", "pattern": "^z10_[0-9]{4}_[0-9]{4}$"}
    },
    "no_food": {
      "type": "array",
      "description": "For enrich and spread, when published: the listed tiles left out of the overlay for food.",
      "items": {"type": "string", "pattern": "^z10_[0-9]{4}_[0-9]{4}$"}
    },
    "budget_usd": {"type": "number", "minimum": 0},
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "When published: the published copy's own tile version."
    },
    "visibility": {"enum": ["public", "private"]},
    "private_to": {"type": "string", "minLength": 1},
    "created_by": {"enum": ["policy", "admin", "enrich", "builder"]},
    "status": {
      "enum": ["queued", "building", "checking", "published", "failed"]
    },
    "progress": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "cost_usd"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"enum": ["building", "checking", "failed"]},
          "report": {"type": "string", "minLength": 1},
          "cost_usd": {"type": "number", "minimum": 0}
        }
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pack"],
      "properties": {
        "pack": {"type": "string", "minLength": 1}
      }
    },
    "review": {
      "type": "object",
      "propertyNames": {"pattern": "^.+$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["result", "at"],
        "properties": {
          "result": {"enum": ["shipped", "not_accepted"]},
          "reason": {"enum": ["quality", "other"]},
          "at": {"type": "string", "minLength": 1}
        }
      }
    },
    "cost_usd": {"type": "number", "minimum": 0},
    "error": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"visibility": {"const": "private"}}},
      "then": {"required": ["private_to"]}
    },
    {
      "if": {"properties": {"kind": {"const": "remake"}}},
      "then": {"required": ["tiles"]},
      "else": {"required": ["tile"]}
    }
  ]
}
