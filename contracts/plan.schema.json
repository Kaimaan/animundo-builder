{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://animundo-builder/contracts/plan.schema.json",
  "title": "One border plan: what the tile needs and what that costs",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "tile",
    "code_only",
    "items",
    "improve",
    "estimate_usd",
    "name",
    "coming",
    "world",
    "planned_at"
  ],
  "properties": {
    "format": {"const": 1},
    "tile": {"type": "string", "pattern": "^z10_[0-9]{4}_[0-9]{4}$"},
    "code_only": {"type": "boolean"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "what", "from", "estimate_usd"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["home", "animal", "plant", "food"]},
          "what": {"type": "string", "minLength": 1},
          "from": {"type": "string", "minLength": 1},
          "estimate_usd": {"type": "number", "minimum": 0},
          "estimate_from": {"type": "string", "minLength": 1}
        }
      }
    },
    "improve": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "what", "from", "estimate_usd"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["home", "animal", "plant", "food"]},
          "what": {"type": "string", "minLength": 1},
          "from": {"type": "string", "minLength": 1},
          "estimate_usd": {"type": "number", "minimum": 0},
          "estimate_from": {"type": "string", "minLength": 1}
        }
      }
    },
    "estimate_usd": {"type": "number", "minimum": 0},
    "name": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "fi"],
      "properties": {
        "en": {"type": "string", "minLength": 1},
        "fi": {"type": "string", "minLength": 1}
      }
    },
    "country": {"type": "string", "minLength": 1},
    "region_id": {"type": "string", "pattern": "^[a-z]{2}_[a-z0-9_]+$"},
    "coming": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
    },
    "looked_for": {
      "description": "Habitat-fitting library animals asked about on an improve but in neither the answer nor the place: enrich candidates without --want (#167.4).",
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
    },
    "world": {"type": "string", "minLength": 1},
    "planned_at": {"type": "string", "minLength": 1},
    "gaps": {
      "description": "Food gaps by species, a report since 0061: never items, never a filter.",
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["diet", "hunts"],
        "properties": {
          "diet": {"type": "array", "items": {"type": "string"}},
          "hunts": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "blocked": {
      "description": "Why nothing can be built here yet: a reason for the game to show, or, for a place plan, the surveyed animals the builder can't make.",
      "anyOf": [
        {"type": "string", "minLength": 1},
        {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["what", "reason"],
            "properties": {
              "what": {"type": "string", "minLength": 1},
              "reason": {"enum": ["needs_reference", "not_makeable", "not_a_plant"]}
            }
          }
        }
      ]
    },
    "survey": {
      "description": "For a place plan: the path of its survey.json.",
      "type": "string",
      "minLength": 1
    },
    "probe": {
      "description": "The code-only probe left undecided: needs_survey says the tile needs one survey before the plan can say more, and estimate_usd is that survey's cost (#169.3).",
      "enum": ["needs_survey"]
    },
    "survey_from": {
      "description": "Where the probe survey's dollars came from: fixed, or the cost log's rows (#259.4).",
      "type": "string",
      "minLength": 1
    },
    "blocked_detail": {
      "description": "What a no_home/no_land block is missing: reason, habitat, ecoregion, its name, realm and RESOLVE biome (#280.4).",
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "reason": {"type": "string", "minLength": 1},
        "habitat": {"type": ["string", "null"]},
        "ecoregion": {"type": ["integer", "null"]},
        "ecoregion_name": {"type": ["string", "null"]},
        "realm": {"type": ["string", "null"]},
        "kind": {"type": ["integer", "null"]}
      }
    },
    "wanted": {
      "description": "What the survey found that the world doesn't have yet, so the game can say why a no_animal plan waits (#281.1).",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "what", "part"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "what": {"type": "string", "minLength": 1},
          "part": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
