{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://animundo-builder/contracts/tile-group.schema.json",
  "title": "One group file: 8 by 8 cells with their ready tiles and blocked cells",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "grid", "group", "version", "tiles", "blocked"],
  "properties": {
    "format": {"const": 1},
    "grid": {"const": "z10"},
    "group": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"type": "integer", "minimum": 0, "maximum": 127}
    },
    "version": {"type": "integer", "minimum": 1},
    "tiles": {
      "type": "object",
      "propertyNames": {"pattern": "^z10_[0-9]{4}_[0-9]{4}$"},
      "additionalProperties": {"type": "object"}
    },
    "blocked": {
      "type": "object",
      "propertyNames": {"pattern": "^z10_[0-9]{4}_[0-9]{4}$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reason", "habitat"],
        "properties": {
          "reason": {"enum": ["no_home", "no_land", "no_animal", "excluded", "species_place"]},
          "habitat": {
            "enum": [
              "boreal_forest",
              "boreal_lake",
              "desert",
              "forest",
              "grassland",
              "ice",
              "lake",
              "mangrove",
              "mountain",
              "rainforest",
              "reef",
              "river",
              "savanna",
              "sea",
              "tundra",
              "wetland",
              "dry_forest",
              "mediterranean",
              "open_ocean"
            ]
          },
          "wanted": {
            "type": "array",
            "description": "What the survey found living here that the world doesn't have yet, at most 12, in the survey's order. A playable animal wanted in a no_animal tile would open it.",
            "maxItems": 12,
            "items": {"$ref": "#/$defs/wanted_entry"}
          },
          "survey_left_out": {
            "type": "array",
            "description": "What the survey found that has a file but still isn't on the tile: the tile's labels or the select dropped it. Each names its first part and a short why. A report, never a request (#278.3).",
            "items": {"$ref": "#/$defs/left_out_entry"}
          },
          "problems": {
            "type": "array",
            "description": "Why the tile blocked, one line per failing check, when the reason alone would drop them (a food-only failure keeps its problems on its no_animal, #272.5).",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "places": {
      "type": "object",
      "description": "Hand-made places' wanted lists by tile, filed from their surveys (#170.2). Never under tiles: the tile stays the hand-made region. The game reads these for enrich.",
      "propertyNames": {"pattern": "^z10_[0-9]{4}_[0-9]{4}$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["region", "wanted", "surveyed_at"],
        "properties": {
          "region": {"type": "string", "minLength": 1},
          "wanted": {
            "type": "array",
            "maxItems": 12,
            "items": {"$ref": "#/$defs/wanted_entry"}
          },
          "surveyed_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
        }
      }
    }
  },
  "$defs": {
    "wanted_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "what", "part"],
      "properties": {
        "kind": {"enum": ["animal", "plant"]},
        "what": {
          "type": "string",
          "pattern": "^([a-z][a-z0-9_]*|gbif:[0-9]+)$"
        },
        "part": {"type": "string", "minLength": 1}
      }
    },
    "left_out_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["what", "part", "why"],
      "properties": {
        "what": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "part": {"type": "string", "minLength": 1},
        "why": {"type": "string", "minLength": 1}
      }
    }
  }
}
