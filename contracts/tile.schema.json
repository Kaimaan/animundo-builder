{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://animundo-builder/contracts/tile.schema.json",
  "title": "One ready tile: land built by code from a home, a seed and GBIF species",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "id",
    "kind",
    "version",
    "center",
    "grid_north",
    "level",
    "height",
    "edges",
    "requires"
  ],
  "properties": {
    "format": {"const": 1},
    "id": {"type": "string", "pattern": "^[ns]_[0-9]{3}_[0-9]{3}$"},
    "kind": {"enum": ["code", "place"]},
    "version": {"type": "integer", "minimum": 1},
    "center": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lat", "lon"],
      "properties": {
        "lat": {"type": "number", "minimum": -90, "maximum": 90},
        "lon": {"type": "number", "minimum": -180, "maximum": 180}
      }
    },
    "grid_north": {"type": "number", "minimum": -180, "maximum": 180},
    "level": {"type": "integer", "minimum": 1},
    "height": {"enum": [32, 64]},
    "habitat": {
      "enum": [
        "boreal_forest",
        "boreal_lake",
        "desert",
        "forest",
        "grassland",
        "ice",
        "lake",
        "mangrove",
        "mountain",
        "rainforest",
        "reef",
        "river",
        "savanna",
        "sea",
        "tundra",
        "wetland",
        "dry_forest",
        "mediterranean",
        "open_ocean"
      ]
    },
    "coast": {
      "type": "array",
      "description": "Land against sea, only on a cell that is part land and part sea or open ocean: 5 strings of 5, `1` land and `0` sea. Row 0 runs along the `n` side, row 4 along `s`; character 0 is west, 4 east.",
      "minItems": 5,
      "maxItems": 5,
      "items": {"type": "string", "pattern": "^[01]{5}$"}
    },
    "ecoregion": {"type": "integer", "minimum": 0},
    "home": {"type": "string", "minLength": 1},
    "blend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["home", "share"],
      "properties": {
        "home": {"type": "string", "minLength": 1},
        "share": {"type": "number", "minimum": 0.1, "maximum": 0.5}
      }
    },
    "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647},
    "water": {"type": "number", "minimum": 0, "maximum": 1},
    "wanted": {
      "type": "array",
      "description": "What the survey found living here that the world doesn't have yet, at most 12, in the survey's order. The game ranks these by play and builds the top few as enrich jobs.",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "what", "part"],
        "properties": {
          "kind": {"enum": ["animal", "plant"]},
          "what": {
            "type": "string",
            "pattern": "^([a-z][a-z0-9_]*|gbif:[0-9]+)$",
            "description": "An animal-list id, a plant id, or gbif:<key>. Ids only, never model text."
          },
          "part": {"type": "string", "minLength": 1}
        }
      }
    },
    "species": {
      "type": "object",
      "additionalProperties": false,
      "required": ["playable", "prey", "predators"],
      "properties": {
        "playable": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        },
        "prey": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        },
        "predators": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        }
      }
    },
    "edges": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n", "e", "s", "w"],
      "properties": {
        "n": {
          "type": "array",
          "minItems": 65,
          "maxItems": 65,
          "items": {"type": "integer"}
        },
        "e": {
          "type": "array",
          "minItems": 65,
          "maxItems": 65,
          "items": {"type": "integer"}
        },
        "s": {
          "type": "array",
          "minItems": 65,
          "maxItems": 65,
          "items": {"type": "integer"}
        },
        "w": {
          "type": "array",
          "minItems": 65,
          "maxItems": 65,
          "items": {"type": "integer"}
        }
      }
    },
    "landmarks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "wikidata"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "fi": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "wikidata": {"type": "string", "pattern": "^Q[0-9]+$"}
        }
      }
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "required": ["homes", "animals"],
      "properties": {
        "homes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "animals": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["habitat", "water", "species"],
      "properties": {
        "habitat": {"type": "string", "minLength": 1},
        "water": {"type": "string", "minLength": 1},
        "species": {"type": "string", "minLength": 1},
        "elevation": {"type": "string", "minLength": 1}
      }
    },
    "made": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by", "maker", "world", "at"],
      "properties": {
        "by": {"const": "tile_maker"},
        "maker": {"type": "string", "minLength": 1},
        "world": {"type": "string", "minLength": 1},
        "at": {"type": "string", "minLength": 1}
      }
    },
    "place": {"type": "string", "minLength": 1},
    "part": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"type": "integer", "minimum": 0}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "code"}}},
      "then": {
        "required": ["habitat", "ecoregion", "home", "seed", "water", "species", "sources", "made"],
        "properties": {"place": false, "part": false}
      }
    },
    {
      "if": {"properties": {"kind": {"const": "place"}}},
      "then": {
        "required": ["place", "part"],
        "properties": {
          "habitat": false,
          "ecoregion": false,
          "home": false,
          "blend": false,
          "seed": false,
          "water": false,
          "species": false
        }
      }
    }
  ]
}
