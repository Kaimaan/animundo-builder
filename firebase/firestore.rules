rules_version = '2';

// Border requests, areas, judge builds, jobs, the admin inbox,
// the admin actions and the off switch. The game's deploy copies
// the marked block into its own firestore.rules; only that block
// is merged.
service cloud.firestore {
  match /databases/{database}/documents {
    // BEGIN animundo-builder
    // One request per border tile, written only by the game's
    // border function and daily job (Admin SDK). Admins read;
    // no client writes. It holds no player data.
    match /border_requests/{tile} {
      allow read: if request.auth != null
        && exists(
          /databases/$(database)/documents/admins/$(request.auth.uid));
      allow write: if false;
    }

    // One area per border tile, written only by the builder's
    // worker. Anyone signed in reads (the game shows it on the
    // map); no client writes.
    match /areas/{tile} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // A judge's private build. Only that judge and admins read;
    // the border function creates it, the worker updates it.
    match /judge_builds/{id} {
      allow read: if request.auth != null
        && (
          resource.data.judge_uid == request.auth.uid
          || exists(
            /databases/$(database)/documents/admins/$(request.auth.uid))
        );
      allow write: if false;
    }

    // Judge accounts, made by hand in the console with each
    // judge's cap. That judge and admins read; nobody writes
    // from a client.
    match /judges/{uid} {
      allow get: if request.auth != null
        && (
          uid == request.auth.uid
          || exists(
            /databases/$(database)/documents/admins/$(request.auth.uid))
        );
      allow list, write: if false;
    }

    // The worker's own record: no client access.
    match /jobs/{jobId} {
      allow read, write: if false;
    }

    // The off switch: the game reads, the core team changes it
    // in the console, never from a client.
    match /config/builder {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Admins, added by hand in the console. An account reads only
    // its own entry, to learn whether it is one.
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    // The admin panel's inbox: admins read, the worker writes,
    // admins mark items handled and nothing else.
    match /admin_inbox/{id} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow create, delete: if false;
      allow update: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['handled', 'handled_at', 'updated_at'])
        && 'handled' in request.resource.data.diff(resource.data)
          .affectedKeys()
        && request.resource.data.handled is bool;
    }

    // What the admin panel asks the worker to do about a border
    // area: approve it, turn it down, ship an item, refuse an
    // item, reopen it. Admins write the request, the worker
    // carries it out.
    match /admin_actions/{id} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow create: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && request.resource.data.admin_uid == request.auth.uid
        && request.resource.data.keys().hasOnly(
          ['admin_uid', 'action', 'tile', 'item', 'reason', 'note', 'at'])
        && request.resource.data.keys().hasAll(
          ['admin_uid', 'action', 'tile', 'at'])
        && request.resource.data.admin_uid is string
        && request.resource.data.action in
          ['approve_request', 'turn_down_request', 'ship_item',
           'not_accepted_item', 'reopen_request']
        && request.resource.data.tile is string
        && request.resource.data.tile.matches('^[ns]_[0-9]{3}_[0-9]{3}$')
        && (!('item' in request.resource.data)
          || request.resource.data.item is string)
        && (
          request.resource.data.action != 'ship_item'
          && request.resource.data.action != 'not_accepted_item'
          || (
            'item' in request.resource.data
            && request.resource.data.item.size() > 0
          )
        )
        && (!('reason' in request.resource.data)
          || request.resource.data.reason in
            ['too_costly', 'odd_request', 'not_now', 'quality', 'other'])
        && (
          request.resource.data.action != 'turn_down_request'
          && request.resource.data.action != 'not_accepted_item'
          || (
            'reason' in request.resource.data
          )
        )
        && (!('note' in request.resource.data)
          || (
            request.resource.data.note is string
            && request.resource.data.note.size() <= 300
          ))
        && request.resource.data.at is timestamp
        && request.resource.data.at <= request.time;
      allow update, delete: if false;
    }
    // END animundo-builder
  }
}
