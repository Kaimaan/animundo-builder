rules_version = '2';

// A judge's private preview pack: only that judge and admins
// read it, the worker writes it. The game's deploy copies the
// marked block into its own storage.rules; only that block is
// merged. No listing anywhere.
service firebase.storage {
  match /b/{bucket}/o {
    // BEGIN animundo-builder
    match /previews/{buildId}/{version}/{file=**} {
      // `get`, never `read`: in Storage rules `read` includes `list`,
      // and nobody lists a preview folder.
      allow get: if request.auth != null
        && (
          firestore.exists(
            /databases/(default)/documents/admins/$(request.auth.uid))
          || (
            firestore.exists(
              /databases/(default)/documents/judge_builds/$(buildId))
            && firestore.get(
              /databases/(default)/documents/judge_builds/$(buildId))
              .data.judge_uid == request.auth.uid
          )
        );
      allow write: if false;
    }
    // END animundo-builder
  }
}
