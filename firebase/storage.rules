rules_version = '2';

// The builder's own Storage paths: published tiles, review batches
// and private judge previews. The game merges this block into its
// own storage.rules; only this block is merged. All Firestore rules
// are the game's. No listing anywhere.
service firebase.storage {
  match /b/{bucket}/o {
    // BEGIN animundo-builder
    // Published tiles: anyone signed in reads one file. The game's
    // daily job reads the index and groups from here.
    match /tiles/v1/{file=**} {
      // `get`, never `read`: in Storage rules `read` includes `list`,
      // and nobody lists the tiles.
      allow get: if request.auth != null;
      allow write: if false;
    }

    // Review batches: what `builder take` downloads, and each
    // item's build report. Admins only.
    match /review/{job}/{item}/{file=**} {
      allow get: if request.auth != null
        && firestore.exists(
          /databases/(default)/documents/admins/$(request.auth.uid));
      allow write: if false;
    }

    // A private job's preview pack: only that job's judge and
    // admins read it. The job names its judge in `private_to`.
    match /previews/{job}/{version}/{file=**} {
      allow get: if request.auth != null
        && (
          firestore.exists(
            /databases/(default)/documents/admins/$(request.auth.uid))
          || (
            firestore.exists(
              /databases/(default)/documents/build_jobs/$(job))
            && firestore.get(
              /databases/(default)/documents/build_jobs/$(job))
              .data.private_to == request.auth.uid
          )
        );
      allow write: if false;
    }
    // END animundo-builder
  }
}
