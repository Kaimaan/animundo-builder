{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://animundo-builder/schemas/area.schema.json",
  "title": "One natural area from the index, as the intake stage reads it",
  "type": "object",
  "additionalProperties": false,
  "required": ["area_id", "name", "country", "centroid"],
  "properties": {
    "area_id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "country": {"type": "string", "pattern": "^[A-Z]{2}$"},
    "centroid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lat", "lon"],
      "properties": {"lat": {"type": "number"}, "lon": {"type": "number"}}
    },
    "ecoregion": {"type": "string"},
    "biome": {"type": "string"},
    "buildable": {"type": "boolean"},
    "outline": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [{"type": "number"}, {"type": "number"}],
        "minItems": 2,
        "maxItems": 2
      }
    }
  }
}
