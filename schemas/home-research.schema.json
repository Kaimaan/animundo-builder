{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://animundo-builder/schemas/home-research.schema.json",
  "title": "Food names for a home's missing food kinds",
  "type": "object",
  "additionalProperties": false,
  "required": ["foods", "sources"],
  "properties": {
    "foods": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {"type": "string", "minLength": 1}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
