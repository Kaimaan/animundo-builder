{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://animundo-builder/schemas/measurements.schema.json",
  "title": "Sourced size plus proportions and colours measured from the sheet",
  "type": "object",
  "additionalProperties": false,
  "required": ["species", "reference", "sourced", "measured", "comparison", "redrawn"],
  "properties": {
    "species": {"type": "string", "minLength": 1},
    "reference": {"enum": ["sheet", "none"]},
    "sourced": {
      "type": "object",
      "additionalProperties": false,
      "required": ["body_cm", "tail_cm", "weight_kg"],
      "anyOf": [{"required": ["shoulder_cm"]}, {"required": ["wingspan_cm"]}],
      "not": {"required": ["shoulder_cm", "wingspan_cm"]},
      "properties": {
        "body_cm": {"type": "number", "exclusiveMinimum": 0},
        "tail_cm": {"type": "number", "exclusiveMinimum": 0},
        "shoulder_cm": {"type": "number", "exclusiveMinimum": 0},
        "wingspan_cm": {"type": "number", "exclusiveMinimum": 0},
        "weight_kg": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "measured": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["proportions", "colours"],
      "properties": {
        "proportions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["body_length", "body_height", "torso_depth", "leg_length", "head_size", "tail_length"],
          "properties": {
            "body_length": {"type": "number", "exclusiveMinimum": 0},
            "body_height": {"type": "number", "exclusiveMinimum": 0},
            "torso_depth": {"type": "number", "exclusiveMinimum": 0},
            "leg_length": {"type": "number", "minimum": 0},
            "head_size": {"type": "number", "exclusiveMinimum": 0},
            "tail_length": {"type": "number", "minimum": 0}
          }
        },
        "colours": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["hex", "fraction"],
            "properties": {
              "hex": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
              "fraction": {"type": "number", "minimum": 0, "maximum": 1}
            }
          }
        }
      }
    },
    "comparison": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["proportion", "sourced", "measured", "within_15_percent"],
        "properties": {
          "proportion": {"type": "string", "minLength": 1},
          "sourced": {"type": "number", "exclusiveMinimum": 0},
          "measured": {"type": "number", "minimum": 0},
          "within_15_percent": {"type": "boolean"}
        }
      }
    },
    "redrawn": {"type": "boolean"}
  }
}
