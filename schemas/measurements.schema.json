{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://animundo-builder/schemas/measurements.schema.json",
  "title": "Proportions and colours measured from reference masks",
  "type": "object",
  "additionalProperties": false,
  "required": ["species", "proportions", "colours"],
  "properties": {
    "species": {"type": "string", "minLength": 1},
    "photos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "licence"],
        "properties": {
          "source": {"type": "string"},
          "licence": {"type": "string"}
        }
      }
    },
    "proportions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["body_length", "body_height", "leg_length", "head_size", "tail_length"],
      "properties": {
        "body_length": {"type": "number", "exclusiveMinimum": 0},
        "body_height": {"type": "number", "exclusiveMinimum": 0},
        "leg_length": {"type": "number", "exclusiveMinimum": 0},
        "head_size": {"type": "number", "exclusiveMinimum": 0},
        "tail_length": {"type": "number", "minimum": 0}
      }
    },
    "colours": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hex", "fraction"],
        "properties": {
          "hex": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
          "fraction": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    }
  }
}
