{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://animundo-builder/schemas/safety.schema.json",
  "title": "The child-safety verdict on every text item",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "verdict", "reasons", "rule"],
        "properties": {
          "key": {"type": "string", "minLength": 1},
          "verdict": {"enum": ["pass", "rewrite", "fail"]},
          "reasons": {"type": "array", "items": {"type": "string"}},
          "rule": {"type": "string"}
        }
      }
    }
  }
}
