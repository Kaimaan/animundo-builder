{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://animundo-builder/schemas/survey.schema.json",
  "title": "Researched facts about a place, each with its sources",
  "type": "object",
  "additionalProperties": false,
  "required": ["area_id", "facts", "species"],
  "properties": {
    "area_id": {"type": "string", "minLength": 1},
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["topic", "text", "sources"],
        "properties": {
          "topic": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "sources": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "species": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["species", "role", "evidence", "sources"],
        "properties": {
          "species": {"type": "string", "minLength": 1},
          "latin": {"type": "string"},
          "role": {"enum": ["playable", "predator", "prey"]},
          "evidence": {"type": "string", "minLength": 1},
          "sources": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "conservation": {"type": "string"},
          "sensitive": {"type": "boolean"}
        }
      }
    }
  }
}
