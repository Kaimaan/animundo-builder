#!/bin/sh
# Fetch animundo-world at the pinned commit next to this checkout (#250.3).
# The tests that need the world skip without it; run this once to run them.
# Same pin as CI (.github/workflows/check.yml WORLD_REV).
set -eu
PIN="a0717b6ff966217a4f95a4654e150b55a654977b"
HERE="$(cd "$(dirname "$0")/.." && pwd)"
DEST="${1:-$(dirname "$HERE")/animundo-world}"
if [ -d "$DEST/.git" ]; then
  git -C "$DEST" fetch -q origin "$PIN" 2>/dev/null || true
  git -C "$DEST" checkout -q "$PIN"
else
  git clone -q --no-checkout https://github.com/Kaimaan/animundo-world "$DEST"
  git -C "$DEST" checkout -q "$PIN"
fi
echo "animundo-world at $(git -C "$DEST" rev-parse --short HEAD) in $DEST"
